# Laravel API base URL (e.g. https://api.yourdomain.com/api/v1 for production)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Название сайта в заголовках страниц: «Каталог – Светофор Мебели»
VITE_API_SITENAME=Светофор Мебели

# Секрет для POST /internal/cache/invalidate (тот же, что FRONTEND_SSR_CACHE_INVALIDATE_SECRET на backend)
# FRONTEND_SSR_CACHE_INVALIDATE_SECRET=your-secret
