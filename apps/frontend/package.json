{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:perf:run": "npm run api:perf:run --prefix ../..",
    "api:perf:generate": "npm run api:perf:generate --prefix ../..",
    "api:perf": "npm run api:perf --prefix ../..",
    "dev": "vite",
    "dev:ssr": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build",
    "build:ssr": "NODE_ENV=production vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && vite build --ssr src/lib/api-ssr.ts --outDir dist/server/lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:ssr": "NODE_ENV=production tsx server/index.ts",
    "start:ssr": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "4.0.2",
    "@supabase/supabase-js": "2.57.4",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dequal": "^2.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "firebase": "12.0.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-geolocated": "^4.4.0",
    "react-i18next": "^15.6.0",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.6.3",
    "recharts": "3.2.0",
    "swr": "^2.3.8",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
