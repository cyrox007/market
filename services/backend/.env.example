APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL витрины (React) — returnUrl оплаты, ссылки в письмах
# APP_FRONTEND_URL=https://your-shop-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Параллельные воркеры для `php artisan serve --no-reload` (Docker задаёт 4)
# PHP_CLI_SERVER_WORKERS=4

# API timing metrics (в Docker по умолчанию store выключен, если Redis не настроен)
# API_METRICS_STORE_ENABLED=false

# Р-5: доступ к /api-docs/metrics только по токену (заголовок X-Metrics-Token или ?token=). Пусто = закрыто.
# API_METRICS_TOKEN=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis (расширение ext-redis) или predis (без расширения)
REDIS_CLIENT=predis
# В Docker: REDIS_HOST=redis. Локально: 127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Raiffeisen Acquiring (платёжная форма / СБП)
# RAIFFEISEN_PUBLIC_ID=
# RAIFFEISEN_SECRET_KEY=
# RAIFFEISEN_PAYMENT_URL=https://pay-test.raif.ru/pay

# Raiffeisen e-commerce API (pay.raif.ru) — оплата картой для всех регионов
# Test: https://pay-test.raif.ru | Prod: https://pay.raif.ru
# RAIFFEISEN_ECOM_PUBLIC_ID=
# RAIFFEISEN_ECOM_SECRET_KEY=
# RAIFFEISEN_ECOM_IS_TEST=true
# Callback URL: в ЛК Raif Pay указать полный URL: https://yourdomain.com/api/v1/payment/raiffeisen-ecom/callback
# При localhost — WAF может блокировать (445). Для тестов: ngrok или реальный домен в APP_FRONTEND_URL

# Sberbank e-commerce acquiring (тест: https://ecomtest.sberbank.ru/doc)
# SBERBANK_ACQUIRING_USERNAME=testMerchant_071
# SBERBANK_ACQUIRING_PASSWORD="your-password"
# SBERBANK_ACQUIRING_BASE_URL=https://ecomtest.sberbank.ru
# SBERBANK_ACQUIRING_API_FORMAT=ecom
# (optional) SBERBANK_ACQUIRING_CALLBACK_URL=https://your-backend-domain.com/api/v1/payment/sberbank/callback
# (local only, if cURL 60) SBERBANK_ACQUIRING_VERIFY_SSL=false

# Сброс SSR-кэша главной после правки подборок в админке (опционально)
# FRONTEND_SSR_CACHE_INVALIDATE_URL=http://127.0.0.1:3000/internal/cache/invalidate
# FRONTEND_SSR_CACHE_INVALIDATE_SECRET=your-secret
