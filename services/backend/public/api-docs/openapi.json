        "tags": ["Cart"],
        "security": [{"session": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id"],
                "properties": {
                  "product_id": {"type": "integer", "example": 1, "description": "ID товара"},
                  "quantity": {"type": "integer", "example": 1, "minimum": 1, "description": "Количество (по умолчанию 1)"},
                  "color": {"type": "string", "nullable": true, "example": "красный", "description": "Цвет (для вариативных товаров)"},
                  "size": {"type": "string", "nullable": true, "example": "180x90", "description": "Размер (для вариативных товаров)"}
                }
              }
            }
          }
        },
        "responses": {
