                    "items": {"type": "array", "items": {"type": "object"}},
                    "subtotal": {"type": "number", "format": "float", "example": 15000.00},
                    "item_count": {"type": "integer", "example": 3},
                    "is_empty": {"type": "boolean", "example": false}
