                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "Товар добавлен в корзину"},
                    "item": {"type": "object"},
                    "requested_quantity": {"type": "integer", "example": 1},
                    "added_quantity": {"type": "integer", "example": 1},
                    "was_adjusted": {"type": "boolean", "example": false}
